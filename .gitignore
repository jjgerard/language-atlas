node_modules/
# Geometry sources: ~65 MB, downloaded on first build, reproducible from
# build-geometry.js
sources/
# The running SQLite database. Approved entries are persisted as
# data/<domain>.json instead (see src/gitStore.js), which is what a rebuilt
# machine boots from.
data/*.db
data/*.db-journal
# Dated backups taken when the local db is re-seeded from data/*.json.
# seedIfEmpty() only fills an EMPTY database, so a local db keeps whatever
# it was seeded with and quietly serves stale coding until it is replaced.
data/*.db.stale-*

# Local admin credentials for development.
.env

# The WALS CLDF release: languages/parameters/codes/values, plus the Glottolog
# table beside them. ~7.7 MB of third-party data, reproducible from
# https://github.com/cldf-datasets/wals, so it follows the same rule as
# sources/ above. research/tools/wals/wals.js says so when they are absent.
research/tools/wals/*.csv

# Extracted text of cited sources, fetched by attribute-sources.js. Rebuildable
# from the web and large; the attributions it produces live in
# data/field-sources.json, which IS committed.
.source-cache/

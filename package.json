{
  "name": "language-atlas",
  "version": "0.1.0",
  "description": "One world map over several domains of language policy, reading the DLD and EAL trackers' live catalogs and forwarding contributions back to them.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "build": "node --max-old-space-size=6144 build-geometry.js && node assemble.js",
    "snapshot": "node -e \"require('./src/catalog').writeSnapshot().then(c=>console.log(c))\""
  },
  "license": "MIT",
  "author": "Juliana Gerard",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "nodemailer": "^9.0.5",
    "polygon-clipping": "^0.15.7"
  },
  "main": "src/server.js"
}
